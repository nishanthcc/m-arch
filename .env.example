# ==============================================================================
# M-ARCH Root Configuration Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider Modes: "Ollama", "Groq", "Auto", "Hybrid"
AI_MODE=Auto
AI_PRIMARY_PROVIDER=Groq
AI_FALLBACK_PROVIDER=Ollama

# Groq Cloud Settings (Never commit your actual key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Settings (Recommended: qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Local Embeddings & Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANK_ENABLED=true
HYBRID_RETRIEVAL_DENSE_WEIGHT=0.6
HYBRID_RETRIEVAL_FTS_WEIGHT=0.4

# Database and Storage Paths
DATABASE_URL=sqlite+aiosqlite:///./data/m_arch.db
VECTOR_STORAGE_PATH=./data/vectors
STORAGE_DIR=./data/storage
UPLOAD_MAX_MB=100

# Limits and Timeouts
AGENT_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

